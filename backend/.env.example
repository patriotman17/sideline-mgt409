# Backend-specific settings. Copy to backend/.env.
# Shared secrets (PORTKEY_API_KEY) go in the repo-root .env.
APP_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API (Expo web dev server by default)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082

# --- Sideline AI (Phase 2C). PORTKEY_API_KEY lives in the repo-root .env. ---
AI_MODEL=gpt-6-luna
# AI_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=@azure-openai        # only if your key has no default route
AI_DAILY_BUDGET_USD=2.0
AI_MAX_OUTPUT_TOKENS=700
AI_REQUEST_LIMIT=5
AI_TOOL_CALLS_LIMIT=8
AI_RATE_LIMIT_PER_MINUTE=8
# AI_INPUT_PRICE_PER_MTOK=0.20          # override bundled price data if billing differs
# AI_OUTPUT_PRICE_PER_MTOK=0.50
AI_AUDIT_LOG_PATH=logs/ai_audit.jsonl
# gpt-6-luna (Azure chat completions) only supports tools with reasoning effort "none"
AI_REASONING_EFFORT=none
# Ask Sideline conversation window per replay session (older turns keep only their questions)
AI_HISTORY_TURNS=6
AI_HISTORY_MAX_CHARS=3000

# Optional: Supabase accounts. The backend only needs the project URL to fetch the PUBLIC
# JWT signing keys (JWKS) and verify login tokens. No Supabase secret is ever needed here.
# Leave blank to disable account endpoints (guest replays/AI keep working).
SUPABASE_URL=

# Optional: read historical NFL games from Supabase (history.* tables) instead of the committed CSVs.
# "local" (default) needs nothing else and is the automatic fallback if Supabase can't be read.
REPLAY_DATA_SOURCE=local
# Connection string for the READ-ONLY sideline_reader role (backend-only secret; never the service role):
# postgresql://sideline_reader.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_DB_URL=
