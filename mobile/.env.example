# PUBLIC client config only. EXPO_PUBLIC_* values are bundled into the app
# and visible to anyone — NEVER put API keys or secrets here.
# iOS simulator / web: http://localhost:8000
# Android emulator:   http://10.0.2.2:8000
# Physical device:    http://<your-computer-LAN-IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional: accounts (Supabase). Leave blank to run guest demo only. Both values are public by
# design (Supabase "publishable" key); Row Level Security in the database protects user data.
# NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
